# Copy this file to .env and fill in real values before running the backend.

# SQLite file path (relative to backend/prisma)
DATABASE_URL="file:./dev.db"

# Any long random string — used to sign JWTs
JWT_SECRET="change-this-to-a-long-random-string"

# Port the Express server listens on
PORT=4000

# Public base URL of this backend, used to build absolute /uploads URLs
# returned by POST /api/admin/upload. Leave blank in local dev (it falls back
# to the request's own host); set explicitly in production (e.g. behind a
# proxy where req.protocol/host aren't reliable).
PUBLIC_URL=

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN="http://localhost:5173"

# Razorpay — leave blank to run in mock-payment mode (no real charges,
# create-order/verify-payment always succeed). Fill in to accept real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
