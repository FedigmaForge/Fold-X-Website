# Copy this file to .env and adjust if needed.

# Base URL of the backend (see backend/.env.example) — no trailing slash.
VITE_API_URL=http://localhost:4000

# Optional: only needed if you want the real Razorpay checkout widget to load.
# Leave blank to use the backend's mock-payment mode (see backend/.env.example).
VITE_RAZORPAY_KEY_ID=
